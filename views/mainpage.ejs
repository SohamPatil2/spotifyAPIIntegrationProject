<%- include('partials/mainpageheader') %>

<style>
    /* 1. UPGRADED 3-COLUMN MACRO SKELETON */
    .dashboard-layout {
        display: grid;
        grid-template-columns: 260px 1fr 20vw; 
        height: calc(100vh - 8em); 
        width: 100vw;
        gap: 2em;            
        padding: 2em 2em 0 0; 
    }
    
    /* NEW: Extracted inline styles for the Left Sidebar */
    .left-sidebar-slot {
        background: transparent;
        border-right: 1px solid rgba(255, 255, 255, 0.05);
    }

    .workspace-window { 
        grid-column: 2; 
        overflow-y: auto; 
        /* Prepares the workspace for smooth scrolling */
        scroll-behavior: smooth;
    }
    
    .right-panel-slot { 
        grid-column: 3; 
        display: flex; 
        flex-direction: column; 
        align-items: flex-start; 
    }

    /* 2. BOTTOM PLAYER SLOT */
    .player-bottom-slot {
        position: fixed; bottom: 2em; left: 0; width: 100vw; 
        display: flex; justify-content: center; z-index: 1000; pointer-events: none; 
    }
    .player-bottom-slot > * { pointer-events: auto; }

    /* 3. MOBILE TRIGGER BUTTON STYLES (The Edge Notch) */
    .mobile-dashboard-trigger {
        display: none; 
    }

    @media (max-width: 600px) {
        .mobile-dashboard-trigger {
            display: flex;
            position: fixed;
            top: 50%; 
            right: 0; 
            transform: translateY(-50%);
            width: 2.2em; 
            height: 5em;  
            background: rgba(12, 12, 14, 0.65);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-right: none; 
            border-radius: 0.75em 0 0 0.75em; 
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            justify-content: center;
            align-items: center;
            box-shadow: -4px 0 15px rgba(0,0,0,0.5);
            z-index: 9999; 
            cursor: pointer;
            transition: background 0.2s, padding-right 0.2s;
        }

        .mobile-dashboard-trigger:active {
            background: rgba(255, 255, 255, 0.1);
            padding-right: 0.4em; 
        }

        .md-trigger-icon {
            width: 65%;
            height: 65%;
            filter: invert(100%) opacity(70%); 
        }
    }

    /* 4. MOBILE LAYOUT HANDLING
    @media (max-width: 900px) {
        .dashboard-layout { grid-template-columns: 1fr; padding: 1em 1em 8em 1em; height: auto; }
        .right-panel-slot, .left-sidebar-slot { display: none; }
    } */
</style>

<div class="main-dashboard-wrapper">
    <div class="dashboard-layout">
        
        <aside class="left-sidebar-slot"></aside>
        
        <main class="workspace-window">
            </main>
        
        <div class="right-panel-slot">
            <%- include('components/now-playing') %>
        </div>
        
    </div>
    
    <div class="player-bottom-slot">
        <%- include('components/player') %>
    </div>
</div>

<%- include('components/mobile-sidebar') %>

<button class="mobile-dashboard-trigger" id="mobileTriggerBtn">
    <img src="https://img.icons8.com/fluency-systems-filled/96/headphone.png" alt="Dashboard" class="md-trigger-icon">
</button>

<%- include('partials/mainpagefooter') %>